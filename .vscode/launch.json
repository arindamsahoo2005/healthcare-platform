{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run Arindam Healthcare (F5)",
            "request": "launch",
            "mainClass": "com.healthcare.platform.HealthcareApplication",
            "projectName": "healthcare-platform",
            "vmArgs": "-XX:+UseContainerSupport -Dfile.encoding=UTF-8"
        },
        {
            "name": "Run Spring Boot via Terminal Task",
            "type": "node-terminal",
            "request": "launch",
            "command": ".\\mvnw.cmd spring-boot:run"
        }
    ]
}
